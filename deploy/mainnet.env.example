# Clashy MAINNET (after the hackathon): Solana mainnet + MagicBlock mainnet rollup, Supabase Postgres, paid RPC.
# Copy to deploy/mainnet.env (gitignored), fill in, then:
#   docker compose --env-file deploy/mainnet.env --profile prod up -d
#   docker compose --env-file deploy/mainnet.env run --rm relay npx tsx scripts/preflight.ts mainnet
# Real money: deploy the program only with Nick, after the devnet rehearsal and the audit fixes (docs/AUDIT.md).
CLASHY_ENV=mainnet
CLASHY_LOCAL=0
CLASHY_DOMAIN=play.clashy.fun
CLASHY_APP_ORIGIN=https://play.clashy.fun
# a paid RPC (Helius Developer: 50 RPC/s); never the public mainnet endpoint
CLASHY_BASE=https://mainnet.helius-rpc.com/?api-key=
CLASHY_ER=https://eu.magicblock.app
CLASHY_ER_VALIDATOR=
CLASHY_TREASURY=
CLASHY_SPONSOR=/app/chain/.keys/mainnet-sponsor.json
CLASHY_AUTHORITY=/app/chain/.keys/mainnet-authority.json
CLASHY_PRIVY_APP_ID=
CLASHY_PRIVY_APP_SECRET=
CLASHY_SOCIAL_SECRET=
CLASHY_INDEXER_SECRET=
CLASHY_TRUST_PROXY=1
# Supabase: Project Settings > Database > Connection pooling (transaction mode) URI
CLASHY_DATABASE_URL=
CLASHY_DB_POOL=10
