# Clashy TESTNET (hackathon): Solana devnet + MagicBlock devnet rollup, one small VM, SQLite.
# Copy to deploy/testnet.env (gitignored), fill in, then:
#   docker compose --env-file deploy/testnet.env --profile prod up -d
#   docker compose --env-file deploy/testnet.env run --rm relay npx tsx scripts/preflight.ts testnet
CLASHY_ENV=devnet
CLASHY_LOCAL=0
CLASHY_DOMAIN=play.clashy.fun
CLASHY_APP_ORIGIN=https://play.clashy.fun
CLASHY_BASE=https://api.devnet.solana.com
# MagicBlock's Private Ephemeral Rollup (TEE, validator 1.1.1): built-in cranks, private accounts, the oracle feeds.
# The regional devnet rollups (devnet-as/eu/us) run validator 2.0, where cranks need a Hydra cranker.
CLASHY_ER=https://devnet-tee.magicblock.app
CLASHY_ER_VALIDATOR=MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo
CLASHY_TREASURY=
# key files inside the containers (put them in chain/.keys/, chmod 600; mounted read-only)
CLASHY_SPONSOR=/app/chain/.keys/devnet-sponsor.json
CLASHY_AUTHORITY=/app/chain/.keys/devnet-authority.json
# the price crank: its own key, never the admin key (the program refuses that)
CLASHY_CRANK=/app/chain/.keys/testnet-crank.json
CLASHY_PRIVY_APP_ID=
CLASHY_PRIVY_APP_SECRET=
# openssl rand -hex 32 (each)
CLASHY_SOCIAL_SECRET=
CLASHY_INDEXER_SECRET=
CLASHY_TRUST_PROXY=1
# empty = SQLite on the social-data volume
CLASHY_DATABASE_URL=
